# NestJS (default 3001 so it does not clash with Next.js on 3000)
PORT=3001

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/my_portfolio?schema=public"

# Single-owner portfolio (not SaaS yet)
SITE_OWNER_NAME=Giorgi
SITE_OWNER_EMAIL=hello@example.com
JWT_SECRET=change-me-use-long-random-string
JWT_EXPIRES=7d
# After the first admin exists, set false to block open registration
REGISTRATION_OPEN=true

# Cloudflare R2 (S3-compatible) — portfolio images & assets
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_ACCESS_KEY_SECRET=
R2_BUCKET=portfolio
# Public URL: R2.dev subdomain or custom domain (no trailing slash)
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# Optional: used for local-disk upload fallback URLs
PUBLIC_API_URL=http://localhost:3001
# Comma-separated browser origins (your Next.js URL, not vercel.com dashboard)
CORS_ORIGIN=http://localhost:3000