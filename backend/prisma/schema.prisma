generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum EmploymentType {
  REMOTE
  FULL_TIME
  PART_TIME
  OTHER
  CONTRACT
  FREELANCE
  INTERNSHIP
}

enum SkillCategory {
  LANGUAGE
  FRAMEWORK
  LIBRARY
  DATABASE
  TOOL
  PLATFORM
  OTHER
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String?
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

/// Singleton row — personal portfolio owner (not multi-tenant).
model SiteProfile {
  id String @id @default("owner")

  fullName     String
  shortLabel   String?
  roleTitle    String?
  heroTitle    String? @db.Text
  heroSubtitle String? @db.Text
  aboutBody    String? @db.Text
  email        String
  phone        String?
  location     String?
  avatarUrl    String?
  availability String?

  githubUrl   String?
  linkedinUrl String?
  twitterUrl  String?
  websiteUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_profile")
}

model ContactMessage {
  id        String   @id @default(cuid())

  name      String
  email     String
  subject   String?
  message   String   @db.Text

  isRead    Boolean  @default(false)
  isReplied Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead])
  @@index([createdAt])
  @@map("contact_messages")
}


model Project {
  id           String   @id @default(cuid())

  title        String
  slug         String   @unique
  subtitle     String?
  description  String   @db.Text

  category     String?
  role         String?
  year         Int?

  imageUrl     String?
  galleryUrls  String[] @default([])
  repoUrl      String?
  demoUrl      String?

  tags         String[] @default([])
  technologies String[] @default([])

  skills       Skill[]
  experiences  Experience[]

  featured     Boolean  @default(false)
  published    Boolean  @default(true)
  sortOrder    Int      @default(0)

  startedAt    DateTime?
  completedAt  DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}



model Experience {
  id             String   @id @default(cuid())

  company        String
  position       String
  description    String   @db.Text

  location       String?
  employmentType EmploymentType?

  startDate      DateTime
  endDate        DateTime?
  current        Boolean  @default(false)

  projects       Project[]
  skills         Skill[]

  technologies   String[] @default([])

  featured       Boolean  @default(false)
  published      Boolean  @default(true)
  sortOrder      Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Skill {
  id       String        @id @default(cuid())
  name     String
  slug     String        @unique
  category SkillCategory @default(OTHER)
  iconUrl  String?
  color    String?

  projects     Project[]
  experiences  Experience[]
  educations   Education[]

  published Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, sortOrder])
  @@index([published])
  @@map("skills")
}

model Education {
  id           String  @id @default(cuid())
  institution  String
  degree       String?
  fieldOfStudy String?
  description  String? @db.Text
  location     String?

  startDate DateTime
  endDate   DateTime?
  current   Boolean  @default(false)

  skills Skill[]

  featured    Boolean @default(false)
  published   Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
  @@map("educations")
}